{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm run build",
    "functions": {
        "api/ssr.mjs": {
            "includeFiles": "dist/ssr/**"
        }
    },
    "rewrites": [
        {
            "source": "/ssr",
            "destination": "/api/ssr"
        },
        {
            "source": "/csr",
            "destination": "/"
        }
    ]
}